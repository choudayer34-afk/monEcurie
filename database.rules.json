{
  "rules": {
    "users": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" }
    },
    "codes": {
      "$code": { ".read": "auth != null", ".write": "auth != null && !data.exists()" }
    },
    "foyers": {
      "$fid": {
        ".read": "auth != null && data.child('membres/' + auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('membres/' + auth.uid).exists()) || data.child('membres/' + auth.uid).exists())",
        "membres": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.child('code').val() === root.child('foyers/' + $fid + '/code').val()"
          }
        }
      }
    }
  }
}
